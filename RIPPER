-- ==========================================
-- HÀM HỖ TRỢ TẢI ÂM THANH TỪ GITHUB
-- ==========================================
local function GitAud(soundgit, filename)
    local success, result = pcall(function()
        return writefile(filename .. ".mp3", game:HttpGet(soundgit))
    end)
    if success and getcustomasset then
        return getcustomasset(filename .. ".mp3")
    elseif success and getsynasset then
        return getsynasset(filename .. ".mp3")
    end
    return soundgit
end

-- ==========================================
-- HÀM PHÁT ÂM THANH SIÊU TO (BOOST VOLUME)
-- ==========================================
local function playBoostedSound(assetId, name, volume, rollOffMax, rollOffMin, parent, layers)
    layers = layers or 2 -- Giảm xuống 2 lớp âm thanh phát cùng lúc
    for i = 1, layers do
        local sound = Instance.new("Sound")
        sound.Name = name .. "_Layer" .. i
        sound.SoundId = assetId
        sound.Volume = volume
        sound.RollOffMinDistance = rollOffMin or 50
        sound.RollOffMaxDistance = rollOffMax
        sound.RollOffMode = Enum.RollOffMode.Linear
        sound.Looped = true
        sound.Parent = parent
        sound:Play()
    end
end

-- ==========================================
-- HÀM XỬ LÝ KẾT LIỄU TỨC THÌ (INSTANT KILL)
-- ==========================================
local function killOneShot()
    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChild("Humanoid")
    
    -- Trừ sạch máu trên Client tức thì
    if humanoid then
        humanoid.Health = 0
    end

    -- Gửi RemoteEvent sát thương cực lớn lên Server
    local damageRemote = ReplicatedStorage:FindFirstChild("LocalDamage", true) or ReplicatedStorage:FindFirstChild("ChangeHealth", true)
    
    if damageRemote and damageRemote:IsA("RemoteEvent") then
        damageRemote:FireServer(1000, "SittingItOut", 1, nil)
        damageRemote:FireServer("Damage", 1000)
        print("ngol")
    else
        print("đéo được")
    end
end

